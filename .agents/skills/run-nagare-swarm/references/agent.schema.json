{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "files",
    "tests",
    "remainingRisks"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remainingRisks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

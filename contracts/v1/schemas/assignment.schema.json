{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nagare.dev/contracts/v1/assignment.schema.json",
  "title": "Nagare Assignment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "objective",
    "inputs",
    "capabilities",
    "budget",
    "output_contract",
    "acceptance_criteria",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "parent_assignment_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/artifact_ref"
      },
      "uniqueItems": true
    },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "uniqueItems": true
    },
    "owned_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/capability"
      },
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_duration_seconds", "max_attempts"],
      "properties": {
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_microunits": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts"],
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "media_type"],
            "properties": {
              "kind": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "media_type": {
                "type": "string",
                "minLength": 3,
                "maxLength": 255
              },
              "schema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "uniqueItems": true
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 255
    }
  }
}

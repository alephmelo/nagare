{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nagare.dev/contracts/v1/pack.schema.json",
  "title": "Nagare Workflow Pack Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "nagare",
    "workflows",
    "assets",
    "bindings",
    "secrets",
    "capabilities",
    "policy",
    "inputs",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "nagare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_version"],
      "properties": {
        "minimum_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "digest": {
            "$ref": "common.schema.json#/$defs/digest"
          }
        }
      },
      "uniqueItems": true
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "agent", "approval", "delivery"],
      "properties": {
        "source": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "agent": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "approval": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "delivery": {
          "$ref": "common.schema.json#/$defs/identifier"
        }
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required", "purpose"],
        "properties": {
          "name": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "required": {
            "type": "boolean"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/capability"
      },
      "uniqueItems": true
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_approval",
        "delivery_approval",
        "max_parallel_assignments",
        "max_repair_attempts"
      ],
      "properties": {
        "execution_approval": {
          "enum": ["required", "policy"]
        },
        "delivery_approval": {
          "enum": ["required", "policy"]
        },
        "max_parallel_assignments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_repair_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/port"
      },
      "uniqueItems": true
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/port"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema"],
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  }
}

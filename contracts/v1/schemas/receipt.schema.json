{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nagare.dev/contracts/v1/receipt.schema.json",
  "title": "Nagare Delivery Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "delivery_id",
    "idempotency_key",
    "outcome",
    "artifacts",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "delivery_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 255
    },
    "outcome": {
      "enum": ["applied", "rejected", "failed"]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/artifact_ref"
      },
      "uniqueItems": true
    },
    "external_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "message": {
      "type": "string",
      "maxLength": 4096
    },
    "recorded_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
